# USA local environment — COPY, NEVER COMMIT.
#
# This file is documentation, not configuration: every value below is empty.
# Copy it to `.env` (gitignored — see .gitignore — so it can never be
# committed) and fill in your own keys there. The CLI loads `.env` from the
# directory you invoke it in; the real environment always wins over the file,
# and USA never prints key values (the pre-commit secret scan is the backstop
# if you ever stage the wrong file by hand).

# NVIDIA NIM (OpenAI-compatible) — used by `usa live --provider nvidia`.
# Get one at https://build.nvidia.com (free trial credits available).
NVIDIA_API_KEY=

# Other providers USA knows (full preset table lives in src/agent/providers.ts).
# Uncomment what you use:
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# Google Gemini (OpenAI-compatible endpoint) — get a key at Google AI Studio.
# GEMINI_API_KEY=

# Optional session defaults (CLI flags win over all of these):
# USA_PROVIDER=nvidia
# USA_MODEL=deepseek-ai/deepseek-v4-pro-0813
