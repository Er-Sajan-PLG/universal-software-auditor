# The @xenos1996 scope lives on GitHub Packages (npm.pkg.github.com),
# not the default registry — this file is the scope's address, nothing
# more. It carries NO credentials: per NODE-004, registry tokens are set
# at runtime or via CI secrets and never committed — not even as
# placeholders or in comments naming the token key.
@xenos1996:registry=https://npm.pkg.github.com/
