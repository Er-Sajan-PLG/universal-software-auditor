# The @xenos1996 scope lives on GitHub Packages (npm.pkg.github.com),
# not the default registry — this is the scope's address. Auth comes from
# the environment (export NODE_AUTH_TOKEN=<PAT with read:packages>); CI
# supplies it per-job. No secret is stored here, only the address.
@xenos1996:registry=https://npm.pkg.github.com/
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
