# Registry address for the @xenos1996 scope, plus pnpm's install posture.

# The @xenos1996 scope lives on GitHub Packages (npm.pkg.github.com), not the
# default registry — this line is the scope's address, nothing more. It carries
# NO credentials: per NODE-004, registry tokens are set at runtime or via CI
# secrets and never committed — not even as placeholders or in comments naming
# the token key.
#
# The .npmrc trap (see release.yml): a scoped mapping beats a bare `--registry`
# flag, so every publish leg targeting npmjs must override in SCOPED form.
@xenos1996:registry=https://npm.pkg.github.com/

# pnpm posture.
# - `strict-peer-dependencies` makes a missing peer a hard error instead of a
#   warning, so a package cannot rely on a hoisted neighbour's dependency by
#   accident. That strictness is the reason the workspace moved to pnpm.
# - `auto-install-peers` keeps the DX tolerable: pnpm resolves declared peers
#   itself rather than failing on unmet optional ones.
# - `save-exact=false` preserves the caret ranges package.json already uses.
strict-peer-dependencies=true
auto-install-peers=true

# Husky's prepare script must run on install. pnpm skips lifecycle scripts of
# dependencies by default, but the root project's own scripts always run; kept
# explicit so a future `--ignore-scripts` default change is caught here.
enable-pre-post-scripts=true
